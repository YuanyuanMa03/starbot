  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@types/node": "22.19.19",
    "esbuild": "0.28.0",
    "typescript": "5.9.3",
    "vitest": "3.2.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "version": "0.1.0"
}
